general {
    colors = true
    interval = 1
}

order += "ipv6"
#order += "run_watch DHCP"
#order += "run_watch VPNC"
order += "path_exists VPN"
order += "wireless wlp8s0"
order += "ethernet enp6s0"
order += "cpu_usage"
order += "read_file performance_mode"
order += "load"
order += "disk /"
order += "memory"
order += "volume master"
#order += "tztime local"
order += "tztime berlin"

wireless wlp8s0 {
	format_up = "  (%quality %essid %bitrate) %ip"
	format_down = "  down"
}

ethernet enp6s0 {
	format_up = "  %ip (%speed)"
	format_down = "  down"
}

run_watch DHCP {
	pidfile = "/var/run/dhclient*.pid"
}

run_watch VPNC {
	# file containing the PID of a vpnc process
	pidfile = "/var/run/vpnc/pid"
}

path_exists VPN {
	# path exists when a VPN tunnel launched by nmcli/nm-applet is active
	path = "/proc/sys/net/ipv4/conf/tun0"
}

tztime local {
	format = "%Y-%m-%d %H:%M:%S"
	hide_if_equals_localtime = true
}

tztime berlin {
	format = "%Y-%m-%d %H:%M:%S"
	timezone = "Europe/Berlin"
}

load {
	format = "Δ %1min"
}

cpu_usage {
	format = "  CPU %usage"
}

memory {
	format = "  %used"
	threshold_degraded = "10%"
	format_degraded = "MEMORY: %free"
}

disk "/" {
	format = "  %avail"
	prefix_type = "custom"
}

read_file uptime {
	path = "/proc/uptime"
}

read_file performance_mode {
	path = "/sys/devices/system/cpu/cpu1/cpufreq/scaling_governor"
}


volume master {
	device = "default"
	mixer = "Master"
	mixer_idx = 0
	format = "  %volume"
}
